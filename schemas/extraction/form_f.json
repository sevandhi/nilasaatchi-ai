{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nilasaatchi.local/schemas/extraction/form_f.json",
  "title": "FormFApportionment",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "form_f"
    },
    "serial": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "owner.json"
      }
    },
    "amount_rs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "amount_words": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount_words_value": {
      "type": [
        "integer",
        "null"
      ]
    },
    "award_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "award_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "sec31_gazette_no": {
      "type": [
        "string",
        "null"
      ]
    },
    "sec31_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw": {
      "type": "object"
    },
    "evidence": {
      "$ref": "evidence.json"
    },
    "owner_read_status": {
      "type": "string",
      "enum": [
        "vlm_agreed",
        "vlm_single"
      ],
      "description": "D-032: vlm_agreed only when two independent reads agree (token_sort >= 90)"
    },
    "owner_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "capped at 0.8 when owner_read_status = vlm_single"
    },
    "owner_other_read": {
      "type": [
        "string",
        "null"
      ],
      "description": "the disagreeing second read, for review"
    }
  },
  "required": [
    "record_type",
    "evidence"
  ]
}