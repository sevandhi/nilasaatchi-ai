GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
# Optional
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENTOPO_API_KEY=
AWS_PROFILE=fai-builder        # SSO profile (aws sso login --sso-session fai-tce --use-device-code)
AWS_REGION=ap-south-1
AWS_COST_PROFILE=fai-cost
AWS_SPEND_CAP_USD=15
AWS_TEAM=team49
# Local services
DATABASE_URL=postgresql://nila:nila_local_dev@localhost:5439/nilasaatchi
# API (app/api) — P4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=data
API_MODE=live                   # live | replay (offline demo fallback, T6.4)
WORKSPACE_BACKEND=postgres      # postgres | dynamodb (AWS mode only, P7, approval-gated)
# D-032/D-033: owner names stay masked everywhere unless this is explicitly true (local/dev only —
# never set in a deployed or demo-visible environment). Bank account numbers are never served either way.
ALLOW_DEMO_UNMASK=false
# Set to true only after the user confirms Mistral console training opt-out
MISTRAL_TRAINING_OPTOUT_CONFIRMED=false
  